NODE_ENV=development
PORT=4100
APP_URL=http://localhost:3000

# Shared with price-insight so one pi-session login works across both domains.
SESSION_SECRET=change-me-to-the-same-32-plus-char-secret-as-backend

# Leads is MongoDB Atlas only. Include the database name in the path.
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/leads?retryWrites=true&w=majority

