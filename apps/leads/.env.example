NODE_ENV=development
PORT=4100
APP_URL=http://localhost:3000

# Shared with price-insight so one pi-session login works across both domains.
SESSION_SECRET=change-me-to-the-same-32-plus-char-secret-as-backend

# Dedicated Leads MySQL database (separate schema from price-insight).
LEADS_MYSQL_HOST=127.0.0.1
LEADS_MYSQL_PORT=3306
LEADS_MYSQL_USER=leads
LEADS_MYSQL_PASSWORD=change_me
LEADS_MYSQL_DATABASE=leads
LEADS_DATABASE_URL=mysql://leads:change_me@127.0.0.1:3306/leads

