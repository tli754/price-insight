NUXT_SESSION_PASSWORD=replace-with-a-secret-of-at-least-32-characters
NUXT_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional when the callback URL cannot be inferred:
# NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google

NUXT_PUBLIC_API_URL=http://localhost:4000

# Dev auth bypass — disables Google OAuth and uses a password form instead
# NUXT_DEV_AUTH_BYPASS=true
# NUXT_DEV_AUTH_PASSWORD=changeme
