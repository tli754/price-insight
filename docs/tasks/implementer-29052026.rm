- shopify_line_item_id unique
- shopify_product_id
- shopify_variant_id
- product_id nullable
- sku
- vendor
- title
- variant_title
- quantity
- current_quantity
- unit_price
- total_discount
- grams
- requires_shipping
- fulfillment_status
